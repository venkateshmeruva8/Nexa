# ==============================================================================
# NEXA - Environment Variables Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file containing real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# LiveKit Cloud WebRTC Configuration
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=nexa-assistant
LIVEKIT_ROOM_NAME=

# ------------------------------------------------------------------------------
# Google Gemini & Search Configuration
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key
GOOGLE_CSE_ID=your_custom_search_engine_id

# ------------------------------------------------------------------------------
# Gmail SMTP Configuration (for drafted email notifications)
# ------------------------------------------------------------------------------
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# ------------------------------------------------------------------------------
# Mem0 Long-Term Memory Configuration (Optional)
# ------------------------------------------------------------------------------
MEM0_API_KEY=your_mem0_api_key
USER_NAME=User
MEM0_TELEMETRY=false

# ------------------------------------------------------------------------------
# n8n Automation & MCP Configuration (Optional)
# ------------------------------------------------------------------------------
N8N_MCP_SERVER_URL=https://your-n8n-instance.com/mcp/sse
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/

# ------------------------------------------------------------------------------
# Speech-To-Text / Audio Configuration (Optional)
# ------------------------------------------------------------------------------
WHISPER_MODEL_DIR=
NEXA_STT_ENGINE=faster-whisper
NEXA_VOICE_BACKEND=livekit
